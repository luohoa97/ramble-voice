<component type="desktop-application">
  <id>io.github.luohoa97.RambleVoice</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Ramble Voice</name>
  <summary>Speak a messy ramble, get clean text in your style</summary>
  <developer id="io.github.luohoa97">
    <name>luohoa97</name>
  </developer>
  <description>
    <p>
      Ramble Voice is a voice dictation app. You speak freely, with pauses,
      false starts and filler, and a voice-native language model hears the audio
      and returns clean text written in your style.
    </p>
    <p>
      It is text-only: spoken instructions are transcribed, never obeyed, and the
      app never runs commands. There is no backend, no telemetry and no
      analytics.
    </p>
    <ul>
      <li>On-device by default with Gemma 4, downloaded once from Hugging Face</li>
      <li>Optional Gemini cloud mode with your own free API key</li>
      <li>Global hotkey with hold-to-talk, text insertion, overlay and tray on supported desktops</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.luohoa97.RambleVoice.desktop</launchable>
  <url type="homepage">https://github.com/luohoa97/ramble-voice</url>
