migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# --- Ramble Voice ---
# Secrets: never commit keys, keystores or env files.
.env
.env.*
*.env
**/key.properties
*.jks
*.keystore
*.p12
*.pem
secrets/
# Model weights (Gemma etc.) are downloaded at runtime, never committed.
*.task
*.litertlm
*.bin
*.gguf
*.safetensors
*.tflite
models/
# Linux GTK4 runner engine downloads and build output
build/
*.flatpak
.flatpak-builder/
flatpak-repo/
# Generated code (drift) is committed; local caches are not
.dart_tool/
