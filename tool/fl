#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Runs flutter/dart inside the `ramble` toolbox with a lock so parallel
# callers don't corrupt .dart_tool or build/. Usage: tool/fl flutter analyze
# The time limit runs inside the container: killing only the host-side
# toolbox client would leave the real process running and holding resources.
set -euo pipefail
cd "$(dirname "$0")/.."
limit="${RAMBLE_FL_TIMEOUT:-900}"
exec flock /tmp/ramble-flutter.lock toolbox run -c ramble bash --noprofile --norc -c \
  'export PATH=$HOME/development/flutter/bin:$PATH; cd "$0"; limit="$1"; shift; exec timeout --kill-after=20 "$limit" "$@"' \
  "$PWD" "$limit" "$@"
